{
  "name": "cv-tailor",
  "version": "0.2.0",
  "private": true,
  "description": "Tailor your CV to a job description, entirely locally, using Ollama.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamorad/cv-tailor.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "mammoth": "^1.12.2",
