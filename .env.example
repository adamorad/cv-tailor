# Base URL of the Ollama server the app talks to. Defaults to
# http://localhost:11434, which is correct for a locally installed Ollama.
# Change it when Ollama isn't reachable at localhost — e.g. running via
# `docker compose up` (see docker-compose.yml), where it's set to
# http://ollama:11434 to reach the `ollama` service over the compose network.
OLLAMA_HOST=http://localhost:11434
